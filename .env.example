# Keep this key server-side. Never use a VITE_ prefix.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
PORT=4317
# HOST defaults to 127.0.0.1 locally and 0.0.0.0 in production.
# HOST=0.0.0.0
# Configure only for a known, fixed proxy topology; leave 0 for direct traffic.
TRUST_PROXY_HOPS=0
# API attempts per client / 10 minutes.
API_RATE_LIMIT=120
# Action endpoint attempts per client / 10 minutes.
MODEL_RATE_LIMIT=30
# Action endpoint attempts across this server / hour.
MODEL_GLOBAL_LIMIT=300

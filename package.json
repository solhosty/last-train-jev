{
  "name": "the-last-train",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @last-train/backend dev",
    "start": "pnpm --filter @last-train/backend start",
    "build": "pnpm typecheck && pnpm --filter @last-train/frontend build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @last-train/backend test",
    "test:production": "pnpm --filter @last-train/backend test:production",
    "test:live": "pnpm --filter @last-train/backend test:live",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm build && pnpm test"
  },
  "devDependencies": {
    "prettier": "^3.9.8"
  },
  "description": "A detective escape-room demo using TypeSafe Jev for evidence-based deductions.",
  "engines": {
    "node": ">=22.16.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/solhosty/last-train-jev.git"
  },
  "packageManager": "pnpm@11.22.0"
}
